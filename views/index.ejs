<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <title>Szállásfoglalás</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <p>Foglalások száma: <%= darab %></p>

    <h1>Szállásfoglalás</h1>

    <% if (hibak.length > 0) { %>
        <div class="hiba">
            <% hibak.forEach((h) => { %>
                <p><%= h %></p>
            <% }) %>
        </div>
    <% } %>

    <% if (siker) { %>
        <p class="siker">Sikeres foglalás</p>
    <% } %>

    <form method="post">
        <label>Név:</label>
        <input type="text" name="name" value="<%= adat.name %>">
        <br>
        <label>E-mail:</label>
        <input type="text" name="email" value="<%= adat.email %>">
        <br>
        <label>Dátum és időpont:</label>
        <input type="datetime-local" name="startDate" value="<%= adat.startDate %>">
        <br>
        <label>Vendégek száma:</label>
        <input type="number" name="guests" value="<%= adat.guests %>">
        <br>
        <button type="submit">Foglalás</button>
    </form>
</body>
</html>